# Copy to .env.local for development. In production set these in the host/container.

# Where sign-in, sign-up and password recovery go: "mock" or "api" (atm-iris-api).
AUTH_SOURCE=api

# Where songs, services, people and modules go. Keep "mock" until the API serves
# them (stages 02–04 of atm-iris-api/docs/plans/00-roadmap.md). Mock data resets
# on restart.
DATA_SOURCE=mock

# atm-iris-api base URL, including the /api/v1 prefix. Required when a source is "api".
# Local: http://localhost:3020/api/v1 · Docker on the shared network: http://atm-iris-api:3001/api/v1
API_URL=http://localhost:3020/api/v1

# Encrypts the session cookie (it holds the API tokens). At least 32 characters.
# Required in production. Generate one with: openssl rand -base64 32
SESSION_SECRET=
